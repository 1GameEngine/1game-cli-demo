{
  "name": "minesweeper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "1game build",
    "build:single": "1game build --singleHtml",
    "gameplay:create": "1gameplay create --entry src/game.tsx --out out/debug.1gamerecord",
    "gameplay:step": "1gameplay step out/debug.1gamerecord --ms 16 --repeat 60",
    "gameplay:debug": "node scripts/1gameplay-debug.mjs"
  },
  "dependencies": {
    "@1game/engine-bundle": "1.4.0",
    "solid-js": "1.9.0"
  },
  "devDependencies": {
    "@1game/cli": "1.4.0",
    "@1game/cli-1gameplay": "1.4.0"
  }
}