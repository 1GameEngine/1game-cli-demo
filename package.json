{
  "name": "snake-swipe-game",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "触屏滑动控制的贪吃蛇小游戏（1Game + @1game/skill）",
  "scripts": {
    "build": "1game build",
    "build:single": "1game build --singleHtml",
    "debug:record": "1gameplay create --entry src/game.tsx --out out/debug.1gamerecord && 1gameplay step out/debug.1gamerecord --ms 130 --repeat 30",
    "debug:test": "node scripts/debug-1gameplay.mjs"
  },
  "dependencies": {
    "@1game/engine-bundle": "1.4.0",
    "solid-js": "1.9.0"
  },
  "devDependencies": {
    "@1game/cli": "1.4.0",
    "@1game/cli-1gameplay": "1.4.0",
    "@1game/skill": "1.4.0",
    "typescript": "^5.8.3"
  }
}
